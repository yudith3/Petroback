APP_NAME=petrolida-2027-api
APP_HOST=127.0.0.1
APP_PORT=8998
ENVIRONMENT=development
LOG_LEVEL=debug

CORS_ALLOWED_ORIGINS=http://localhost:3000
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
REQUEST_BODY_LIMIT_BYTES=12582912

DB_HOST=127.0.0.1
DB_PORT=54327
DB_USER=postgres
DB_PASS=postgres
DB_NAME=petrolida_2027
DB_SSL_MODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL=8h
AUTH_COOKIE_NAME=petrolida_admin_session
ADMIN_NAME=
ADMIN_EMAIL=admin@petrolida.com
ADMIN_PASSWORD=
ADMIN_INSTITUTION=PETROLIDA 2027
ADMIN_PHONE=

# Registration stays closed unless both RFC3339 timestamps are configured.
OPREC_REGISTRATION_START_AT=2026-09-23T18:00:00+07:00
OPREC_REGISTRATION_END_AT=2026-10-06T18:00:00+07:00
# Empty value keeps the announcement closed. Use RFC3339 to schedule publication.
# Final staff release (RFC3339). Empty keeps public results closed.
OPREC_ANNOUNCEMENT_AT=
OPREC_INTERVIEW_ANNOUNCEMENT_AT=2026-10-08T10:00:00+07:00
OPREC_STAFF_GROUP_URL=
OPREC_INTERVIEW_SCHEDULE_URL=
OPREC_ALLOWED_BATCHES=2024,2025,2026
OPREC_PORTFOLIO_MAX_BYTES=10485760
OPREC_PORTFOLIO_REQUIRED_SUBDIVISIONS=Creative Design,Experimental Design,Media Production (Editing),Media Production (Field),Web Development - UI/UX
PORTFOLIO_STORAGE_DIR=./data/portfolios
PORTFOLIO_STORAGE_DRIVER=local
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
GDRIVE_TIMEOUT=1m

# PetroRun 2027. Leave all blank while the event configuration is not finalized;
# the public config endpoint will report unavailable instead of exposing mock data.
PETRORUN_BASE_PRICE_IDR=
PETRORUN_ADMIN_FEE_IDR=
PETRORUN_JERSEY_SURCHARGE_2XL_IDR=
PETRORUN_JERSEY_SURCHARGE_3XL_IDR=
PETRORUN_JERSEY_SURCHARGE_4XL_IDR=
PETRORUN_BANK_NAME=
PETRORUN_BANK_ACCOUNT_NUMBER=
PETRORUN_BANK_ACCOUNT_HOLDER=
PETRORUN_ACCESS_SECRET=

# PetroRun: leave every PETRORUN key blank until bank/fees are finalized.
# Normal 150000; early 125000 (25 people); late 139000 from 19 Nov WIB.
# Default registration: 24 Oct through 22 Nov 2026; racepack 25 Nov.
PETRORUN_EARLY_BIRD_PRICE_IDR=
PETRORUN_EARLY_BIRD_QUOTA=
PETRORUN_LATE_PRICE_IDR=
PETRORUN_REGISTRATION_START_AT=
PETRORUN_REGISTRATION_END_AT=
PETRORUN_LATE_START_AT=
PETRORUN_RACEPACK_AT=

# Staging-only synthetic checkout; rejected by the production app identity.
PETRORUN_TEST_MODE=
